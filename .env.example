# Copy this file to .env and fill in your key, then restart the app.
# start.bat / start.sh create the .env file for you on the first run.
# The .env file is git-ignored. On Windows PowerShell you can also set the
# variable for the current session with:
#   $env:GROQ_API_KEY = "gsk_..."

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
